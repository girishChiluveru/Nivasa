# Environment Variables Configuration

# ========================================
# NO API KEYS NEEDED FOR MAPS! 
# Using FREE OpenStreetMap + Leaflet.js
# No registration, no bank details required!
# ========================================

# MongoDB Connection URL (if using cloud MongoDB)
# MONGO_URL=your_mongodb_connection_string_here

# Cloudinary Configuration (already set up)
# CLOUD_NAME=your_cloud_name
# CLOUD_API_KEY=your_api_key
# CLOUD_API_SECRET=your_api_secret

# Session Secret (for production)
# SECRET=your_session_secret_here
